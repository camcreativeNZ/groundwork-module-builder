{
  "name": "groundwork-module-builder",
  "version": "0.1.0",
  "description": "Turns a Groundwork module file (YAML) into a web module and a SCORM 2004 package.",
  "main": "src/index.js",
  "scripts": {
    "build": "node bin/groundwork.js build",
    "check": "node bin/groundwork.js check",
    "build:f3": "node bin/groundwork.js build modules/F3/module.yaml",
    "test": "node --test tests/*.test.js",
    "qa": "node bin/groundwork.js qa",
    "website": "node website/build.js --preview",
    "website:deploy": "node website/build.js && wrangler deploy -c website/wrangler.jsonc",
    "website:test": "node website/build.js && node --test website/test/e2e.test.js",
    "website:dev": "node website/build.js && wrangler dev -c website/wrangler.jsonc"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "axe-core": "^4.10.3",
    "playwright": "1.63.0",
    "yaml": "^2.9.1"
  },
  "private": true,
  "bin": {
    "groundwork": "bin/groundwork.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
